{
  "name": "laa-inquests-external-ui-gatling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docker:up": "docker compose -f ../../docker-compose.test.yaml -f docker-compose.override.yaml up --build -d",
    "docker:down": "docker compose -f ../../docker-compose.test.yaml -f docker-compose.override.yaml down",
    "load-test:smoke": "dotenv -e .env -- gatling run --sources-folder src/simulation --simulation smokeTest --non-interactive",
    "load-test:peak": "dotenv -e .env -- gatling run --sources-folder src/simulation --simulation peakConcurrency --non-interactive",
    "load-test:burst": "dotenv -e .env -- gatling run --sources-folder src/simulation --simulation weeklyBurst --non-interactive"
  },
  "devDependencies": {
    "@gatling.io/cli": "3.16.1",
    "@gatling.io/core": "3.16.1",
    "@gatling.io/http": "3.16.1",
    "dotenv-cli": "^10.0.0",
    "typescript": "^6.0.3"
  }
}
