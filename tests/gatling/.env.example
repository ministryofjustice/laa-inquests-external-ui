# Base URL of the app under test (running via docker:up)
GATLING_BASE_URL=http://localhost:3000

# Access token for an authenticated provider, used to seed a session via
# /auth/test-login (only mounted when NODE_ENV=test). Paste a real Entra
# access token obtained for the test provider account.
GATLING_ACCESS_TOKEN=

# Optional override: comma-separated office/account codes. By default these
# are derived from the access token's own ACCOUNTS claim; only set this if
# you need to force different codes than the token actually carries.
GATLING_OFFICE_ACCOUNTS=
