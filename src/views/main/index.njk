{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% set pageHeading = "Inquests" %}
{% set pageTitle = pageHeading %}

{% block content %}
    <h1 class="govuk-heading-xl">{{ pageHeading }}</h1>

    <p class="govuk-body">{{ t('pages.home.defaultTemplate') }}</p>


    {% if hasRole(appRoles.APPLICATION_USER) %}
        {{ govukButton({
            text: "Apply",
            href: "/apply"
        }) }}
    {% endif %}

    {% if hasRole(appRoles.CLAIMS_USER) %}
        {{ govukButton({
            text: "Make a claim",
            href: "/claim"
        }) }}
    {% endif %}

{% endblock %}