{% extends "base.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% set pageHeading = "Confirm the following" %}
{% set pageTitle = pageHeading %}

{% block content %}
<div class="govuk-width-container">
    {{ govukBackLink({
        text: "Back",
        href: "/apply/check-your-answers"
    }) }}
    {% if errorSummaries.noDeclarationConfirmation %}
    {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: [
            { text: errorSummaries.noDeclarationConfirmation.text }
        ]
    }) }}
    {% endif %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">{{ pageHeading }}</h1>
            <form data-testid="client-declaration-form" action="/apply/confirmation/client-declaration" method="post">
                <input type="hidden" name="_csrf" value="{{csrfToken}}" />
                <p class="govuk-body">You must obtain a signed declaration from your client which confirms that:</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>
                        they, {{clientDetails.firstName}} {{clientDetails.lastName}}, have instructed you, {{providerName}}, to represent them
                    </li>
                    <li>
                        they have read and agree to the <a class="govuk-link" href="https://www.gov.uk/guidance/legal-aid-agency-privacy-notice" target="_blank">Legal Aid Agency privacy policy</a>
                    </li>
                    <li>
                        the information they have given is complete and correct
                    </li>
                </ul>
                {% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

                {{ govukWarningText({
                    html: 
                        "You must also explain to your client that if information they have given is wrong or incomplete, or they don't tell us about any changes, they may:
                        <ul>
                            <li>be prosecuted</li>
                            <li>have to pay a financial penalty</li>
                            <li>have their legal aid stopped and have to pay back any costs</li>
                        </ul>",
                    iconFallbackText: "Warning",
                    classes: "govuk-!-margin-bottom-0"
                }) }}
                <p class="govuk-body">A copy of this declaration will be included in your confirmation email. You can print this for your client to sign.</p>
                <p class="govuk-body">On behalf of {{providerName}}, you must confirm that:</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>
                        the information you have provided in this application is complete and correct
                    </li>
                    <li>
                        you are authorised by {{providerName}} to submit legal aid applications against this contract
                    </li>
                    <li>
                        you will obtain a signed copy of this declaration from your client, keep a copy on file, and provide it to the legal aid agency on request
                    </li>
                </ul>
                {{ govukWarningText({
                    html:
                        "Making a false declaration may lead to further action, including:
                        <ul>
                            <li>prosecution</li>
                            <li>nullification of certificates</li>
                            <li>contract sanctions against your firm</li>
                        </ul>",
                    iconFallbackText: "Warning",
                    classes: "govuk-!-margin-bottom-0"
                }) }}
                {% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}

                {{ govukCheckboxes({
                name: "client-declaration-confirmation",
                errorMessage: errorSummaries.noDeclarationConfirmation,
                items: [
                    {
                    value: "true",
                    text: "I confirm that I have read and agree to the declaration"
                    }
                ]
                }) }}
                {{ govukButton({
                    text: "Submit",
                    classes: "govuk-!-margin-top-2"
                }) }}
            </form>
        </div>
    </div>
</div>
{% endblock %}