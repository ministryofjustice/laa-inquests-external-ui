{% extends "base.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set pageHeading = "Upload coroner's letter" %}
{% set pageTitle = pageHeading %}

{% block content %}
<div class="govuk-width-container">
  {{ govukBackLink({
      text: "Back",
      href: backHref or "/apply/public-authority"
  }) }}
  <main class="govuk-main-wrapper">
  {% if errorSummaries %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [
            {
              text: errorSummaries.coronersLetterError.text,
              href: "#coroners-letter-upload"
            }
          ]
        })
      }}
    {% endif %}
    <h1 class="govuk-heading-l">{{ pageHeading }}</h1>
    {% if uploadedFile %}
      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Uploaded file" },
            value: { text: uploadedFile.fileName }
          }
        ]
      }) }}
      <form action="/apply/upload-coroners-letter/delete" method="post">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        {{ govukButton({
          text: "Delete",
          classes: "govuk-button--secondary"
        }) }}
      </form>
    {% else %}
    <form data-testid="upload-coroners-letter-form" action="/apply/upload-coroners-letter" method="post" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{csrfToken}}" />
      {{ govukFileUpload({
        id: "coroners-letter-upload",
        name: "coroners-letter-file-upload",
        label: {
          text: "Attach a file",
          classes: "govuk-label--m"
        },
        hint: {
          text: "The maximum file size is 10MB. Accepted file types are PDF, JPG, PNG and BMP."
        },
        attributes: {
          accept: ".pdf,.jpg,.jpeg,.png,.bmp"
        },
        javascript: true,
        errorMessage: errorSummaries.coronersLetterError
      }) }}
      {{ govukButton({ text: "Continue" }) }}
    </form>
    {% endif %}
  </main>
</div>
{% endblock %}