{% extends "base.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set pageHeading = "Upload correspondence from the coroner" %}
{% set pageTitle = pageHeading %}

{% block content %}
<div class="govuk-width-container">
  {{ govukBackLink({
      text: "Back",
      href: backHref or "/apply/public-authority"
  }) }}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
    {% if errorSummaries and errorSummaries.coronersLetterError %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{
            text: errorSummaries.coronersLetterError.text,
            href: "#documents"
          }
        ]
      })
    }}
  {% endif %}
  <h1 class="govuk-heading-l">{{ pageHeading }}</h1>

      
  <p class="govuk-body">Your file should include details of the inquest, including specific reference to one or more public authorities being named as interested parties. We will use this evidence when assessing your claim.</p>
        <p class="govuk-body">The maximum file size for each file is 10MB. We can accept these file types:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>pdf</li>
            <li>jpeg, jpg</li>
            <li>png</li>
            <li>bmp</li>
        </ul>
        <p class="govuk-body">Filenames should only include the letters a-z, numbers 0-9, and the characters .!()_-. Using other characters in your filenames could cause the uploads to fail.</p>

      <form data-testid="uploaded-coroners-letter"
        action="/apply/upload-coroners-letter/upload" method="post" enctype="multipart/form-data"
        {% if not uploadedFile %}hidden{% endif %}>
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <input type="hidden" name="uploadMode" value="html" />
        <h2 class="govuk-heading-m">{{ t("pages.apply.coronersLetter.uploadedFiles") }}</h2>
        {% set fileNameHtml %}
          <span data-uploaded-filename>{{ uploadedFile.originalFileName }}</span>
        {% endset %}
        {% set deleteButtonHtml %}
          {{ govukButton({
            text: t("pages.apply.coronersLetter.deleteFileButton"),
            classes: "govuk-button--secondary govuk-!-margin-bottom-0",
            name: "delete",
            value: uploadedFile.fileName,
            type: "submit",
            attributes: {
              "aria-label": t("pages.apply.coronersLetter.deleteFileButton") + " " + uploadedFile.originalFileName
            }
          }) }}
        {% endset %}
        {{ govukSummaryList({
          rows: [{
            key: { html: fileNameHtml, classes: "govuk-!-font-weight-regular" },
            value: { html: deleteButtonHtml, classes: "govuk-!-text-align-right" }
          }]
        }) }}
      </form>

      <form action="/apply/upload-coroners-letter/upload" method="post" enctype="multipart/form-data"
        data-module="coroners-letter-upload">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <input type="hidden" name="uploadMode" value="html" />

        {% set errorMessage = errorSummaries.coronersLetterError if errorSummaries and errorSummaries.coronersLetterError %}

        {{ govukFileUpload({
            id: "documents",
            name: "documents",
            label: {
              text: t("pages.apply.coronersLetter.uploadNewFile"),
              classes: "govuk-label--m"
            },
            javascript: true,
            disabled: uploadedFile is defined,
            attributes: { accept: ".pdf,.jpg,.jpeg,.png,.bmp" },
            errorMessage: errorMessage
          }) }}

        {{ govukButton({
          text: t("pages.apply.coronersLetter.uploadFileButton"),
          classes: "govuk-button--secondary",
          type: "submit"
        }) }}
      </form>

      <form data-testid="upload-coroners-letter-form" action="/apply/upload-coroners-letter" method="post">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        {{ govukButton({
          text: t("common.continue"),
          type: "submit"
        }) }}
      </form>
    </div>
  </div>
</div>
{% endblock %}