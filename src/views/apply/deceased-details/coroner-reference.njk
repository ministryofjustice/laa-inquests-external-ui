{% extends "base.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% set pageHeading = "Do you have a reference number from the coroner? (optional)" %}
{% set pageTitle = pageHeading %}

{% block content %}
<div class="govuk-width-container">
    {{ govukBackLink({
        text: "Back",
        href: backHref or "/apply/deceased-details/client-relationship"
    }) }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            {% if errorSummaries %}
            {{ govukErrorSummary({
                titleText: "There is a problem",
                errorList: [
                    {
                        text: errorSummaries.coronerReferenceInputError.text,
                        href: "#deceased-coroner-reference"
                    }
                ]
            }) }}
            {% endif %}
            <form data-testid="deceased-coroner-reference-form" action="/apply/deceased-details/coroner-reference" method="post">
                <input type="hidden" name="_csrf" value={{csrfToken}} />
                {{ govukInput({
                    id: "deceased-coroner-reference",
                    name: "deceased-coroner-reference",
                    type: "text",
                    spellcheck: false,
                    label: {
                        text: pageHeading,
                        classes: "govuk-label--l",
                        isPageHeading: true
                    },
                    hint: {
                        text: "If your correspondence with the coroner has included a reference for this inquest, enter it here."
                    },
                    errorMessage: errorSummaries.coronerReferenceInputError,
                    value: deceasedDetails.coronerReference
                }) }}
                {{ govukButton({
                    text: "Continue"
                }) }}
            </form>
        </div>
    </div>
<div>
{% endblock %}