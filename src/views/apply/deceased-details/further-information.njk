{% extends "base.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% set pageHeading = "Are there any other inquests relating to this incident?" %}
{% set pageTitle = pageHeading %}

{% block content %}
<div class="govuk-width-container">
    {{ govukBackLink({
        text: "Back",
        href: backHref or "/apply/deceased-details/coroner-reference"
    }) }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            {% if errorSummaries.hasFurtherInformationInputError or errorSummaries.furtherInformationInputError %}
            {{ govukErrorSummary({
                titleText: "There is a problem",
                errorList: [
                    {
                        text: errorSummaries.hasFurtherInformationInputError.text,
                        href: "#deceased-has-further-information"
                    } if errorSummaries.hasFurtherInformationInputError,
                    {
                        text: errorSummaries.furtherInformationInputError.text,
                        href: "#deceased-further-information"
                    } if errorSummaries.furtherInformationInputError
                ]
            }) }}
            {% endif %}
            <h1 class="govuk-heading-l">{{ pageHeading }}</h1>
            <form data-testid="deceased-further-information-form" action="/apply/deceased-details/further-information" method="post">
                <input type="hidden" name="_csrf" value={{csrfToken}} />
                {{ govukRadios({
                    name: "deceased-has-further-information",
                    id: "deceased-has-further-information",
                    value: deceasedDetails.hasFurtherInformation,
                    errorMessage: errorSummaries.hasFurtherInformationInputError,
                    items: [
                        {
                            value: "true",
                            text: "Yes",
                            conditional: {
                                html:  govukTextarea({
                                    id: "deceased-further-information",
                                    name: "deceased-further-information",
                                    type: "text",
                                    spellcheck: false,
                                    label: {
                                        text: "Enter details of any linked or bridged inquests you are aware of (optional)"
                                    },
                                    errorMessage: errorSummaries.furtherInformationInputError,
                                    value: deceasedDetails.furtherInformation
                                }
                            )}
                        },
                        {
                            value: "false",
                            text: "No"
                        },
                        {
                            value: "false",
                            text: "Don't know"
                        }
                    ]
                }) }}
                {{ govukButton({
                    text: "Continue"
                }) }}
            </form>
        </div>
    </div>
</div>
{% endblock %}