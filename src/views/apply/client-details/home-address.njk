{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set pageHeading = "What is your client's home address?" %}
{% set pageTitle = pageHeading %}

{% block content %}

<div class="govuk-width-container">
  {{ govukBackLink({
    text: "Back",
    href: "/apply/client-details/has-prev-application"
  }) }}
  <main class="govuk-main-wrapper">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        {% if errorSummaries %}
          {{ govukErrorSummary({
            titleText: "There is a problem",
            errorList: [
              {
                text: errorSummaries.addressLine1InputError.text,
                href: "#home-address-line-1"
              },
              {
                text: errorSummaries.addressLine2InputError.text,
                href: "#home-address-line-2"
              },
              {
                text: errorSummaries.townOrCityInputError.text,
                href: "#home-town-or-city"
              },
              {
                text: errorSummaries.countyInputError.text,
                href: "#home-county"
              },
              {
                text: errorSummaries.postcodeInputError.text,
                href: "#home-postcode"
              }
            ]
          })
        }}
        {% endif %}
        <h1 class="govuk-heading-l">{{ pageHeading }}</h1>
        <form data-testid="home-address-form" data-module="conditional-address-fields" action="/apply/client-details/home-address" method="post">
          <input type="hidden" name="_csrf" value="{{csrfToken}}" />
          {{ govukInput({
            label: {
              text: "Address line 1",
              classes: "govuk-label--s"
            },
            id: "home-address-line-1",
            name: "home-address-line-1",
            value: client.homeAddressLine1,
            errorMessage: errorSummaries.addressLine1InputError
          }) }}
          {{ govukInput({
            label: {
              text: "Address line 2 (optional)",
              classes: "govuk-label--s"
            },
            id: "home-address-line-2",
            name: "home-address-line-2",
            value: client.homeAddressLine2,
            errorMessage: errorSummaries.addressLine2InputError
          }) }}
          {{ govukInput({
            label: {
              text: "Town or city",
              classes: "govuk-label--s"
            },
            id: "home-town-or-city",
            name: "home-town-or-city",
            value: client.homeTownOrCity,
            errorMessage: errorSummaries.townOrCityInputError
          }) }}
          {{ govukInput({
            label: {
              text: "County (optional)",
              classes: "govuk-label--s"
            },
            id: "home-county",
            name: "home-county",
            value: client.homeCounty,
            errorMessage: errorSummaries.countyInputError
          }) }}
          {{ govukInput({
            label: {
              text: "Postcode",
              classes: "govuk-label--s"
            },
            id: "home-postcode",
            name: "home-postcode",
            classes: "govuk-input--width-10",
            value: client.homePostcode,
            errorMessage: errorSummaries.postcodeInputError
          }) }}
          {{ govukCheckboxes({
            idPrefix: "has-no-fixed-abode",
            name: "has-no-fixed-abode",
            items: [
              {
                value: "true",
                text: "Client has no fixed abode",
                checked: client.hasNoFixedAbode
              }
            ]
          }) }}
          {{ govukButton({
            text: "Continue"
          }) }}
        </form>
      </div>
    </div>
  </main>
</div>

{% endblock %}
