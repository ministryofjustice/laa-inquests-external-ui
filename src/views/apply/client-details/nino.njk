{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set pageHeading = "Does your client have a National Insurance number?" %}
{% set pageTitle = pageHeading %}

{% set backLink = backHref or "/apply/client-details/name-and-dob" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummaries.ninoInputError or errorSummaries.noRadioSelected %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [
            {
              text: errorSummaries.ninoInputError.text,
              href: "#nino-input"
            },
            {
              text: errorSummaries.noRadioSelected.text,
              href: "#has-nino"
            }
          ] | selectattr("text")
        })
      }}
      {% endif %}
      <form data-testid="nino-form" action="/apply/client-details/nino" method="post">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        {{ govukRadios({
          name: "has-nino",
          id: "has-nino",
          fieldset: {
            legend: {
              text: pageHeading,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          value: client.hasNino,
          errorMessage: errorSummaries.noRadioSelected,
          items: [
            {
              value: "true",
              html: (t("common.yes") | escape) ~ '<span class="govuk-visually-hidden">. ' ~ (t("pages.apply.clientDetails.nino.yesRevealHint") | escape) ~ '</span>',
              conditional: {
                html:  govukInput({
                  id: "nino-input",
                  name: "nino-input",
                  type: "text",
                  spellcheck: false,
                  classes: "govuk-!-width-one-half",
                  label: {
                    text: "Enter your client's National Insurance number"
                  },
                  errorMessage: errorSummaries.ninoInputError,
                  value: client.clientNino
                })
              }
            },
            {
              value: "false",
              text: "No"
            }
          ]
        }) }}
        {{ govukButton({
            text: "Continue"
          }) }}
      </form>
    </div>
  </div>
{% endblock %}