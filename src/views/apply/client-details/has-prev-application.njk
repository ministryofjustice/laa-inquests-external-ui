{% extends "base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set pageHeading = "Has your client applied for legal aid for an inquest before" %}
{% set pageTitle = pageHeading %}

{% block content %}

<div class="govuk-width-container">
  {{ govukBackLink({
    text: "Back",
    href: backHref or "/apply/client-details/nino"
  }) }}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummaries %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [
            {
              text: errorSummaries.referenceInputError.text,
              href: "#prev-laa-reference-input"
            },
            {
              text: errorSummaries.noRadioSelected.text,
              href: "#has-prev-application"
            }
          ]
        })
      }}
      {% endif %}
      <h1 class="govuk-heading-l">{{ pageHeading }}</h1>
      <p class="govuk-body">Let us know if your client has previously applied for legal aid for this, or any other inquests. Please answer even if they did not receive funding.</p>
      <p class="govuk-body">You don't need to tell us about controlled work.</p>
      <form data-testid="has-prev-application-form" action="/apply/client-details/has-prev-application" method="post">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        {{ govukRadios({
          name: "has-prev-application",
          value: client.hasPrevApplication,
          errorMessage: errorSummaries.noRadioSelected,
          items: [
            {
              value: "true",
              text: "Yes",
              conditional: {
                html:  govukInput({
                  id: "prev-laa-reference-input",
                  name: "prev-laa-reference-input",
                  errorMessage: errorSummaries.referenceInputError,
                  type: "text",
                  spellcheck: false,
                  classes: "govuk-!-width-one-half",
                  label: {
                    text: "Enter the LAA reference for any previous applications (optional)"
                  },
                  value: client.prevLaaReference
                })
              }
            },
            {
              value: "false",
              text: "No"
            },
            {
              value: "false",
              text: "Don't know"
            }
          ]
        }) }}
        {{ govukButton({
            text: "Continue"
          }) }}
      </form>
    </div>
  </div>
</div>





{% endblock %}